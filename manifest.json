{
  "manifest_version": 3,
  "name": "Alert Bulk-Close Highlighter",
  "version": "2.0.0",
  "description": "Colours an alert green when its ID is on the bulk-close list. Reads text files bundled inside the extension. No storage, no network access.",
  "host_permissions": [
    "https://CHANGE-ME.your-company.internal/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://CHANGE-ME.your-company.internal/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}